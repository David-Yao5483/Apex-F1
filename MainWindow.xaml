<Window
    x:Class="ApexF1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ApexF1"
    Title="Apex F1">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Language="zh-CN" SizeChanged="Root_SizeChanged">
        <Grid.Resources>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
            <DataTemplate x:Key="SourceCardTemplate" x:DataType="local:SourceLink">
                <Button Click="SourceCard_Click"
                        Tag="{x:Bind}"
                        AutomationProperties.Name="{x:Bind DisplayTitle}"
                        AutomationProperties.HelpText="{x:Bind DisplayDescription}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Height="120"
                        Padding="14,12"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" VerticalAlignment="Top" CornerRadius="8"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{x:Bind DisplayTitle}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind DisplayProvider}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind DisplayDescription}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </Button>
            </DataTemplate>
            <DataTemplate x:Key="CoverCardTemplate" x:DataType="local:SourceLink">
                <Button Click="SourceCard_Click" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind Title}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="216" Padding="0"
                        CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="66" />
                        </Grid.RowDefinitions>
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="7,7,0,0">
                            <Grid>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="26" />
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind ImageUri}" DecodePixelWidth="640" />
                                    </Image.Source>
                                </Image>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1" Text="{x:Bind Title}" Margin="12,8" VerticalAlignment="Center"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>
            </DataTemplate>
            <DataTemplate x:Key="LinkGroupTemplate" x:DataType="local:LinkGroup">
                <StackPanel Spacing="12" Margin="0,0,0,28">
                    <TextBlock Text="{x:Bind DisplayTitle}" Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <ItemsRepeater ItemsSource="{x:Bind Links}" ItemTemplate="{StaticResource SourceCardTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="218" MinItemHeight="120" MinColumnSpacing="12"
                                               MinRowSpacing="12" ItemsStretch="Fill" MaximumRowsOrColumns="5" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
        </Grid.KeyboardAccelerators>

        <TitleBar x:Name="AppTitleBar" Title="Apex F1">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource>
                    <ImageIconSource.ImageSource>
                        <SvgImageSource UriSource="ms-appx:///Assets/Mark.svg" />
                    </ImageIconSource.ImageSource>
                </ImageIconSource>
            </TitleBar.IconSource>
            <TitleBar.Content>
                <Grid Margin="8,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ThemeButton" Style="{StaticResource IconButtonStyle}" Click="ThemeButton_Click"
                            VerticalAlignment="Center" AutomationProperties.Name="切换深浅主题">
                        <FontIcon x:Name="ThemeIcon" FontSize="16" />
                    </Button>
                    <Button x:Name="LanguageButton" Grid.Column="1" Click="LanguageButton_Click"
                            VerticalAlignment="Center" Content="EN" />
                    <AutoSuggestBox x:Name="SearchBox"
                                    Grid.Column="2"
                                    MaxWidth="550"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="搜索栏目、频道或创作者"
                                    PlaceholderText="搜索栏目、频道或创作者"
                                    QueryIcon="Find"
                                    TextChanged="Search_TextChanged"
                                    QuerySubmitted="Search_QuerySubmitted" />
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <SelectorBar x:Name="MainTabs" Grid.Row="1" HorizontalAlignment="Center" Margin="8,2,8,8"
                     AutomationProperties.Name="主导航" SelectionChanged="MainTabs_SelectionChanged">
            <SelectorBarItem x:Name="HomeItem" Tag="home" Text="首页" />
            <SelectorBarItem x:Name="NewsItem" Tag="news" Text="新闻" />
            <SelectorBarItem Tag="standings" Text="积分榜" />
            <SelectorBarItem Tag="results" Text="赛果" />
            <SelectorBarItem Tag="calendar" Text="赛历" />
            <SelectorBarItem Tag="watch" Text="观赛" />
        </SelectorBar>

        <Grid Grid.Row="2">
            <Border Margin="8,0,8,8"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <ScrollViewer x:Name="Hub" HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="HubContent" MaxWidth="1520" Margin="28,18,28,0" Spacing="18">
                            <StackPanel x:Name="PageHeading" Spacing="4">
                                <TextBlock x:Name="PageTitle" Text="首页"
                                           Style="{StaticResource TitleTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level1" />
                                <TextBlock x:Name="PageDescription" TextWrapping="Wrap"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border x:Name="Hero" CornerRadius="10" Height="326" Background="#101E3B">
                                <Grid x:Name="HeroContent" RequestedTheme="Dark">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="HeroArt" Grid.Column="1" Stretch="Fill"
                                           IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                    <Grid Grid.ColumnSpan="2" IsHitTestVisible="False">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#FF101E3B" Offset="0" />
                                                <GradientStop Color="#FF101E3B" Offset="0.25" />
                                                <GradientStop Color="#E6101E3B" Offset="0.42" />
                                                <GradientStop Color="#22101E3B" Offset="0.74" />
                                                <GradientStop Color="#00101E3B" Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                    </Grid>

                                    <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MaxWidth="410" Margin="28,0,22,38" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <Border Width="4" Height="14" Background="#FF839FFF" CornerRadius="2" />
                                            <TextBlock x:Name="HeroLabel" Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontWeight="SemiBold" CharacterSpacing="90" Foreground="#FFC5D4FF" />
                                        </StackPanel>
                                        <TextBlock x:Name="HeroTitle" Style="{StaticResource TitleLargeTextBlockStyle}"
                                                   Foreground="White" TextWrapping="Wrap" />
                                        <TextBlock x:Name="HeroDescription" MaxWidth="340" HorizontalAlignment="Left"
                                                   TextWrapping="Wrap" Foreground="#FFE6EDFF"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <Button x:Name="HeroAction" Click="HeroAction_Click" Margin="0,12,0,0"
                                                MinHeight="36" Padding="16,0" Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14">
                                        <Border Background="#B3101E3B" CornerRadius="16" Padding="10,5">
                                            <TextBlock x:Name="FeatureIndex" Foreground="White"
                                                       AutomationProperties.LiveSetting="Polite"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                        <Button x:Name="PreviousFeatureButton" Click="PreviousFeature_Click" Width="32" Height="32" Padding="0"
                                                ToolTipService.ToolTip="上一张" AutomationProperties.Name="上一张焦点卡片">
                                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                        </Button>
                                        <Button x:Name="NextFeatureButton" Click="NextFeature_Click" Width="32" Height="32" Padding="0"
                                                ToolTipService.ToolTip="下一张" AutomationProperties.Name="下一张焦点卡片">
                                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="OnlineControls" Visibility="Collapsed" Spacing="8">
                                <Button x:Name="RefreshOnlineButton" Content="刷新" Click="RefreshOnline_Click" />
                                <ProgressBar x:Name="OnlineProgress" IsIndeterminate="True" Visibility="Collapsed" />
                                <InfoBar x:Name="F1FeedError" Severity="Warning" IsClosable="False" />
                                <InfoBar x:Name="BiliFeedError" Severity="Warning" IsClosable="False" />
                            </StackPanel>
                            <StackPanel x:Name="NewsPanel" Visibility="Collapsed" Spacing="12" Margin="0,0,0,12">
                                <TextBlock x:Name="NewsHeading" Text="F1 官网新闻" Style="{StaticResource SubtitleTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <ItemsRepeater x:Name="NewsCards" ItemTemplate="{StaticResource CoverCardTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="110" MinItemHeight="216" MaximumRowsOrColumns="3"
                                                           MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <Button x:Name="ReadMoreButton" Content="阅读更多" HorizontalAlignment="Left"
                                        Click="ReadMore_Click" />
                                <TextBlock x:Name="VideosHeading" Text="F1赛事资讯 · 最新视频" Margin="0,12,0,0"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <ItemsRepeater x:Name="VideoCards" ItemTemplate="{StaticResource CoverCardTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="110" MinItemHeight="216" MaximumRowsOrColumns="3"
                                                           MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <Button x:Name="WatchMoreButton" Content="观看更多" HorizontalAlignment="Left"
                                        Click="WatchMore_Click" />
                            </StackPanel>
                            <StackPanel x:Name="StandingsPanel" Visibility="Collapsed" Spacing="12" Margin="0,0,0,18">
                                <SelectorBar x:Name="StandingsTabs" AutomationProperties.Name="积分榜类别"
                                             SelectionChanged="StandingsTabs_SelectionChanged">
                                    <SelectorBarItem x:Name="DriverStandingsItem" Text="车手积分榜" />
                                    <SelectorBarItem x:Name="TeamStandingsItem" Text="车队积分榜" />
                                </SelectorBar>
                                <Grid Padding="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RankHeader" Text="名次" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Name="NameHeader" Grid.Column="1" Text="车手 / 车队" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Name="PointsHeader" Grid.Column="2" Text="积分" HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                                <ItemsControl x:Name="StandingRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:StandingRow">
                                            <Grid Padding="14,10" Margin="0,0,0,2"
                                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="54" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Position}" VerticalAlignment="Center" />
                                                <Grid Grid.Column="1" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Height="52" Width="52" CornerRadius="8"
                                                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE77B;" FontSize="18" />
                                                            <Image Stretch="UniformToFill">
                                                                <Image.Source>
                                                                    <BitmapImage UriSource="{x:Bind ImageUri}" DecodePixelWidth="104" />
                                                                </Image.Source>
                                                            </Image>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind Team}" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{x:Bind Points}" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ItemsRepeater x:Name="Groups" ItemTemplate="{StaticResource LinkGroupTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="Reader" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="10,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button x:Name="CloseReaderButton" Style="{StaticResource IconButtonStyle}" Click="CloseReader_Click"
                                        ToolTipService.ToolTip="返回目录" AutomationProperties.Name="返回目录">
                                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                                </Button>
                                <Button x:Name="BackButton" Style="{StaticResource IconButtonStyle}" Click="Back_Click"
                                        ToolTipService.ToolTip="网页后退" AutomationProperties.Name="网页后退">
                                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                                </Button>
                                <Button x:Name="ForwardButton" Style="{StaticResource IconButtonStyle}" Click="Forward_Click"
                                        ToolTipService.ToolTip="网页前进" AutomationProperties.Name="网页前进">
                                    <FontIcon Glyph="&#xE72A;" FontSize="15" />
                                </Button>
                                <Button x:Name="RefreshReaderButton" Style="{StaticResource IconButtonStyle}" Click="Refresh_Click"
                                        ToolTipService.ToolTip="刷新网页" AutomationProperties.Name="刷新网页">
                                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ReaderTitle" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ReaderAddress" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="ExternalButton" Grid.Column="2" Click="OpenExternal_Click" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="在浏览器打开" AutomationProperties.Name="在浏览器打开">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                    <TextBlock x:Name="ExternalLabel" Text="在浏览器打开" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ProgressBar x:Name="ReaderProgress" IsIndeterminate="True"
                                         VerticalAlignment="Top" Visibility="Collapsed" />
                            <InfoBar x:Name="ReaderError" Grid.Row="0" Severity="Warning" IsClosable="True"
                                     Margin="8,4" />
                            <Border x:Name="WebHost" Grid.Row="1"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
