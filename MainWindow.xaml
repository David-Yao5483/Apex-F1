<Window
    x:Class="ApexF1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ApexF1"
    Title="Apex F1">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Language="zh-CN" SizeChanged="Root_SizeChanged">
        <Grid.Resources>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
            <DataTemplate x:Key="SourceCardTemplate" x:DataType="local:SourceLink">
                <Button Click="SourceCard_Click"
                        Tag="{x:Bind}"
                        AutomationProperties.Name="{x:Bind DisplayTitle}"
                        AutomationProperties.HelpText="{x:Bind DisplayDescription}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Height="120"
                        Padding="14,12"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" VerticalAlignment="Top" CornerRadius="8"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{x:Bind DisplayTitle}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind DisplayProvider}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind DisplayDescription}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </Button>
            </DataTemplate>
            <DataTemplate x:Key="CoverCardTemplate" x:DataType="local:SourceLink">
                <Button Click="SourceCard_Click" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind Title}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="216" Padding="0"
                        CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="66" />
                        </Grid.RowDefinitions>
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="7,7,0,0">
                            <Grid>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="26" />
                                <Image Stretch="UniformToFill" local:CachedImage.RemoteUri="{x:Bind ImageUri}" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1" Text="{x:Bind Title}" Margin="12,8" VerticalAlignment="Center"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>
            </DataTemplate>
            <DataTemplate x:Key="RaceRowTemplate" x:DataType="local:SourceLink">
                <Button Click="RaceRow_Click" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind Title}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="76" Padding="14,10"
                        CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Provider}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" />
                    </Grid>
                </Button>
            </DataTemplate>
            <DataTemplate x:Key="LinkGroupTemplate" x:DataType="local:LinkGroup">
                <StackPanel Spacing="12" Margin="0,0,0,28">
                    <TextBlock Text="{x:Bind DisplayTitle}" Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <ItemsRepeater ItemsSource="{x:Bind Links}" ItemTemplate="{StaticResource SourceCardTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="218" MinItemHeight="120" MinColumnSpacing="12"
                                               MinRowSpacing="12" ItemsStretch="Fill" MaximumRowsOrColumns="5" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
        </Grid.KeyboardAccelerators>

        <TitleBar x:Name="AppTitleBar" Title="Apex F1" AutoRefreshDragRegions="True">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource>
                    <ImageIconSource.ImageSource>
                        <SvgImageSource UriSource="ms-appx:///Assets/Mark.svg" />
                    </ImageIconSource.ImageSource>
                </ImageIconSource>
            </TitleBar.IconSource>
            <TitleBar.LeftHeader>
                <Canvas x:Name="TitleBackSlot" Width="0" Height="48">
                    <Button x:Name="TitleBackButton" Style="{ThemeResource TitleBarBackButtonStyle}"
                            Width="44" Height="44" Margin="0" Canvas.Top="2"
                            Visibility="Collapsed" Opacity="0" Click="TitleBack_Click" />
                </Canvas>
            </TitleBar.LeftHeader>
            <TitleBar.Content>
                <Grid Margin="8,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ThemeButton" Style="{StaticResource IconButtonStyle}" Click="ThemeButton_Click"
                            VerticalAlignment="Center" AutomationProperties.Name="切换深浅主题">
                        <FontIcon x:Name="ThemeIcon" FontSize="16" />
                    </Button>
                    <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                            Click="Refresh_Click" VerticalAlignment="Center" IsEnabled="False"
                            AutomationProperties.Name="刷新当前页面">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                    <Button x:Name="LanguageButton" Grid.Column="2" Click="LanguageButton_Click"
                            VerticalAlignment="Center" Content="EN" />
                    <AutoSuggestBox x:Name="SearchBox"
                                    Grid.Column="3"
                                    MaxWidth="550"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="搜索栏目、频道或创作者"
                                    PlaceholderText="搜索栏目、频道或创作者"
                                    QueryIcon="Find"
                                    TextChanged="Search_TextChanged"
                                    QuerySubmitted="Search_QuerySubmitted" />
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <SelectorBar x:Name="MainTabs" Grid.Row="1" HorizontalAlignment="Center" Margin="8,2,8,8"
                     AutomationProperties.Name="主导航" SelectionChanged="MainTabs_SelectionChanged">
            <SelectorBarItem x:Name="NewsItem" Tag="news" Text="新闻" />
            <SelectorBarItem Tag="standings" Text="积分榜" />
            <SelectorBarItem Tag="results" Text="赛果" />
            <SelectorBarItem Tag="calendar" Text="赛历" />
            <SelectorBarItem Tag="watch" Text="观赛" />
        </SelectorBar>

        <Grid Grid.Row="2">
            <Border Margin="8,0,8,8"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <ScrollViewer x:Name="Hub" HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="HubContent" MaxWidth="1520" Margin="28,18,28,0" Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="PageTitle" Text="新闻"
                                           Style="{StaticResource TitleTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level1" />
                                <TextBlock x:Name="PageDescription" TextWrapping="Wrap"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel x:Name="OnlineControls" Visibility="Collapsed" Spacing="8">
                                <ProgressBar x:Name="OnlineProgress" IsIndeterminate="True" Visibility="Collapsed" />
                                <InfoBar x:Name="F1FeedError" Severity="Warning" IsClosable="False" />
                                <InfoBar x:Name="BiliFeedError" Severity="Warning" IsClosable="False" />
                            </StackPanel>
                            <StackPanel x:Name="NewsPanel" Visibility="Collapsed" Spacing="12" Margin="0,0,0,12">
                                <TextBlock x:Name="NewsHeading" Text="F1 官网新闻" Style="{StaticResource SubtitleTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <ItemsRepeater x:Name="NewsCards" ItemTemplate="{StaticResource CoverCardTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="110" MinItemHeight="216" MaximumRowsOrColumns="3"
                                                           MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <Button x:Name="ReadMoreButton" Content="阅读更多" HorizontalAlignment="Left"
                                        Click="ReadMore_Click" />
                                <TextBlock x:Name="VideosHeading" Text="F1赛事资讯 · 最新视频" Margin="0,12,0,0"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <ItemsRepeater x:Name="VideoCards" ItemTemplate="{StaticResource CoverCardTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="110" MinItemHeight="216" MaximumRowsOrColumns="3"
                                                           MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <Button x:Name="WatchMoreButton" Content="观看更多" HorizontalAlignment="Left"
                                        Click="WatchMore_Click" />
                            </StackPanel>
                            <StackPanel x:Name="ResultsTablePanel" Visibility="Collapsed" Spacing="12">
                                <SelectorBar x:Name="StandingsTabs" Visibility="Collapsed" Height="48"
                                             AutomationProperties.Name="积分榜类别" SelectionChanged="StandingsTabs_SelectionChanged">
                                    <SelectorBarItem x:Name="DriverStandingsItem" Text="车手积分榜" />
                                    <SelectorBarItem x:Name="TeamStandingsItem" Text="车队积分榜" />
                                </SelectorBar>
                                <local:NativeResultsTable x:Name="ResultsTable" />
                            </StackPanel>
                            <ItemsRepeater x:Name="RaceRows" Visibility="Collapsed" ItemTemplate="{StaticResource RaceRowTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <ItemsRepeater x:Name="Groups" ItemTemplate="{StaticResource LinkGroupTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="Reader" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="10,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ForwardButton" Style="{StaticResource IconButtonStyle}" Click="Forward_Click"
                                    VerticalAlignment="Center" ToolTipService.ToolTip="网页前进" AutomationProperties.Name="网页前进">
                                <FontIcon Glyph="&#xE72A;" FontSize="15" />
                            </Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ReaderTitle" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ReaderAddress" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="ExternalButton" Grid.Column="2" Click="OpenExternal_Click" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="在浏览器打开" AutomationProperties.Name="在浏览器打开">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                    <TextBlock x:Name="ExternalLabel" Text="在浏览器打开" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ProgressBar x:Name="ReaderProgress" IsIndeterminate="True"
                                         VerticalAlignment="Top" Visibility="Collapsed" />
                            <InfoBar x:Name="ReaderError" Grid.Row="0" Severity="Warning" IsClosable="True"
                                     Margin="8,4" />
                            <Border x:Name="WebHost" Grid.Row="1"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
