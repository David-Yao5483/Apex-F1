<Window
    x:Class="ApexF1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ApexF1"
    Title="Apex F1">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Language="zh-CN" SizeChanged="Root_SizeChanged">
        <Grid.Resources>
            <Style x:Key="RailItemStyle" TargetType="ListViewItem">
                <Setter Property="Width" Value="66" />
                <Setter Property="Height" Value="62" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="RailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
            <DataTemplate x:Key="SourceCardTemplate" x:DataType="local:SourceLink">
                <Button Click="SourceCard_Click"
                        Tag="{x:Bind}"
                        AutomationProperties.Name="{x:Bind Title}"
                        AutomationProperties.HelpText="{x:Bind Description}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Height="120"
                        Padding="14,12"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" VerticalAlignment="Top" CornerRadius="8"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Provider}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </Button>
            </DataTemplate>
            <DataTemplate x:Key="LinkGroupTemplate" x:DataType="local:LinkGroup">
                <StackPanel Spacing="12" Margin="0,0,0,28">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <ItemsRepeater ItemsSource="{x:Bind Links}" ItemTemplate="{StaticResource SourceCardTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="218" MinItemHeight="120" MinColumnSpacing="12"
                                               MinRowSpacing="12" ItemsStretch="Fill" MaximumRowsOrColumns="5" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
        </Grid.KeyboardAccelerators>

        <TitleBar x:Name="AppTitleBar" Title="Apex F1">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource>
                    <ImageIconSource.ImageSource>
                        <SvgImageSource UriSource="ms-appx:///Assets/Mark.svg" />
                    </ImageIconSource.ImageSource>
                </ImageIconSource>
            </TitleBar.IconSource>
            <TitleBar.Content>
                <Grid Margin="12,0">
                    <AutoSuggestBox x:Name="SearchBox"
                                    MaxWidth="550"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="搜索栏目、频道或创作者"
                                    PlaceholderText="搜索栏目、频道或创作者"
                                    QueryIcon="Find"
                                    TextChanged="Search_TextChanged"
                                    QuerySubmitted="Search_QuerySubmitted" />
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="Rail" AutomationProperties.Name="主导航" Margin="0,10,0,0"
                      HorizontalAlignment="Center" Width="68"
                      ItemContainerStyle="{StaticResource RailItemStyle}"
                      SelectionChanged="Rail_SelectionChanged" IsItemClickEnabled="True" ItemClick="Rail_ItemClick"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollMode="Disabled">
                <ListViewItem x:Name="HomeItem" Tag="home" AutomationProperties.Name="首页">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE80F;" FontSize="19" />
                        <TextBlock Text="首页" Style="{StaticResource RailLabelStyle}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="official" AutomationProperties.Name="F1 官网">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE774;" FontSize="19" />
                        <TextBlock Text="F1 官网" Style="{StaticResource RailLabelStyle}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="watch" AutomationProperties.Name="观赛">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE7F4;" FontSize="19" />
                        <TextBlock Text="观赛" Style="{StaticResource RailLabelStyle}" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="CreatorsItem" Tag="creators" AutomationProperties.Name="创作者">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE716;" FontSize="19" />
                        <TextBlock Text="创作者" Style="{StaticResource RailLabelStyle}" />
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <Border Grid.Column="1" Margin="0,0,8,8"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <ScrollViewer x:Name="Hub" HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="HubContent" MaxWidth="1520" Margin="28,18,28,0" Spacing="18">
                            <StackPanel x:Name="PageHeading" Spacing="4">
                                <TextBlock x:Name="PageTitle" Text="首页"
                                           Style="{StaticResource TitleTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level1" />
                                <TextBlock x:Name="PageDescription" TextWrapping="Wrap"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border x:Name="Hero" CornerRadius="10" Height="326" Background="#101E3B">
                                <Grid x:Name="HeroContent" RequestedTheme="Dark">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="HeroArt" Grid.Column="1" Stretch="Fill"
                                           IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                    <Grid Grid.ColumnSpan="2" IsHitTestVisible="False">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#FF101E3B" Offset="0" />
                                                <GradientStop Color="#FF101E3B" Offset="0.25" />
                                                <GradientStop Color="#E6101E3B" Offset="0.42" />
                                                <GradientStop Color="#22101E3B" Offset="0.74" />
                                                <GradientStop Color="#00101E3B" Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                    </Grid>

                                    <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MaxWidth="410" Margin="28,0,22,38" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <Border Width="4" Height="14" Background="#FF839FFF" CornerRadius="2" />
                                            <TextBlock x:Name="HeroLabel" Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontWeight="SemiBold" CharacterSpacing="90" Foreground="#FFC5D4FF" />
                                        </StackPanel>
                                        <TextBlock x:Name="HeroTitle" Style="{StaticResource TitleLargeTextBlockStyle}"
                                                   Foreground="White" TextWrapping="Wrap" />
                                        <TextBlock x:Name="HeroDescription" MaxWidth="340" HorizontalAlignment="Left"
                                                   TextWrapping="Wrap" Foreground="#FFE6EDFF"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <Button x:Name="HeroAction" Click="HeroAction_Click" Margin="0,12,0,0"
                                                MinHeight="36" Padding="16,0" Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14">
                                        <Border Background="#B3101E3B" CornerRadius="16" Padding="10,5">
                                            <TextBlock x:Name="FeatureIndex" Foreground="White"
                                                       AutomationProperties.LiveSetting="Polite"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                        <Button Click="PreviousFeature_Click" Width="32" Height="32" Padding="0"
                                                ToolTipService.ToolTip="上一张" AutomationProperties.Name="上一张焦点卡片">
                                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                        </Button>
                                        <Button Click="NextFeature_Click" Width="32" Height="32" Padding="0"
                                                ToolTipService.ToolTip="下一张" AutomationProperties.Name="下一张焦点卡片">
                                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsRepeater x:Name="Groups" ItemTemplate="{StaticResource LinkGroupTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="Reader" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="10,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButtonStyle}" Click="CloseReader_Click"
                                        ToolTipService.ToolTip="返回目录" AutomationProperties.Name="返回目录">
                                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                                </Button>
                                <Button x:Name="BackButton" Style="{StaticResource IconButtonStyle}" Click="Back_Click"
                                        ToolTipService.ToolTip="网页后退" AutomationProperties.Name="网页后退">
                                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                                </Button>
                                <Button x:Name="ForwardButton" Style="{StaticResource IconButtonStyle}" Click="Forward_Click"
                                        ToolTipService.ToolTip="网页前进" AutomationProperties.Name="网页前进">
                                    <FontIcon Glyph="&#xE72A;" FontSize="15" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Click="Refresh_Click"
                                        ToolTipService.ToolTip="刷新网页" AutomationProperties.Name="刷新网页">
                                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ReaderTitle" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ReaderAddress" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2" Click="OpenExternal_Click" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="在浏览器打开" AutomationProperties.Name="在浏览器打开">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                    <TextBlock x:Name="ExternalLabel" Text="在浏览器打开" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ProgressBar x:Name="ReaderProgress" IsIndeterminate="True"
                                         VerticalAlignment="Top" Visibility="Collapsed" />
                            <InfoBar x:Name="ReaderError" Grid.Row="0" Severity="Warning" IsClosable="True"
                                     Margin="8,4" />
                            <Border x:Name="WebHost" Grid.Row="1"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
